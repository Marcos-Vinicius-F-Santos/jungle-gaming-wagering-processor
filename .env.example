NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
SQS_ENABLED=false
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_CONSUMER_NAME=wager-transaction-consumer-v1
SQS_WAIT_TIME_SECONDS=10
SQS_MAX_NUMBER_OF_MESSAGES=10
SQS_VISIBILITY_TIMEOUT_SECONDS=60
WAGER_REFERENCE_POLL_INTERVAL_MS=1000
OUTBOX_ENABLED=false
OUTBOX_PUBLISHER_NAME=wager-event-publisher-v1
OUTBOX_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
OUTBOX_EVENTS_DLQ_URL=http://localhost:4566/000000000000/wager-events-dlq.fifo
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_CLAIM_TIMEOUT_SECONDS=60
OUTBOX_RETRY_BACKOFF_SECONDS=30,60,120,240,300
HEALTH_DEPENDENCY_TIMEOUT_MS=500
HEALTH_TOTAL_TIMEOUT_MS=1000


{
  "name": "jungle-gaming-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed wagering processor for the Jungle Gaming technical challenge",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:load": "bun run test/load/run-load.ts",
    "test:resilience": "bun run test/resilience/run-resilience.ts",
    "migration:up": "mikro-orm migration:up --config ./src/infrastructure/database/mikro-orm.config.ts",
    "migration:down": "mikro-orm migration:down --config ./src/infrastructure/database/mikro-orm.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/decorators": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.5",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}

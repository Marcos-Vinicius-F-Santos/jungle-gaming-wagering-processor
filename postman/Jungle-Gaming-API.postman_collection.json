    {
      "name": "8. Casos negativos",
      "item": [
        {
          "name": "Sem Idempotency-Key - esperado 400",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/wagering/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"{{providerId}}\",\n  \"externalTransactionId\": \"missing-key-postman\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-negative\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"1.00\", \"currency\": \"BRL\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }

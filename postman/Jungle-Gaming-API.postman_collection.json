                "exec": [
                  "pm.environment.set(\"pendingReferenceIdempotencyKey\", pm.environment.get(\"providerId\") + \":late-bet:\" + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test(\"BET de referência processada\", function () { pm.expect(body.status).to.eql(\"PROCESSED\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar WIN pendente até convergir",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/providers/{{providerId}}/wagering/transactions/{{pendingExternalId}}",
            "description": "Execute novamente após WAGER_REFERENCE_POLL_INTERVAL_MS. O resultado esperado é PROCESSED. Se ainda estiver PENDING_REFERENCE, aguarde e envie novamente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"estado da referência\", function () { pm.expect([\"PROCESSED\",\"PENDING_REFERENCE\"]).to.include(body.status); });",
                  "if (body.status === \"PROCESSED\") pm.test(\"WIN pendente resolvida\", function () { pm.expect(body.resultBalanceAmount || body.resultBalance?.amount).to.exist; });"
                ]
              }
            }
          ]
        }
      ]

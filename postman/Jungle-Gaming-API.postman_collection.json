{
  "info": {
    "name": "Jungle Gaming API - Teste ponta a ponta",
    "description": "Coleção para validar manualmente a API HTTP do Jungle Gaming. Execute as pastas na ordem. Os testes de concorrência, SQS, crash recovery, resiliência e carga continuam nas suites Bun descritas no GUIA-DE-TESTES.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "providerId",
      "value": "provider-postman"
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Wallet",
      "item": [
        {
          "name": "Criar wallet com saldo inicial",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/wallets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": {\n    \"amount\": \"1000.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get(\"playerId\")) pm.environment.set(\"playerId\", pm.variables.replaceIn('{{$guid}}'));;"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test(\"wallet criada\", function () { pm.expect(body.id).to.be.a(\"string\"); pm.expect(body.balance.amount).to.eql(\"1000.00\"); pm.expect(body.balance.currency).to.eql(\"BRL\"); });",
                  "pm.environment.set(\"walletId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar wallet",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wallets/{{walletId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"saldo correto\", function () { pm.expect(body.balance.amount).to.eql(\"1000.00\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar ledger",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wallets/{{walletId}}/ledger?limit=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"ledger retornado\", function () { pm.expect(body.walletId).to.eql(pm.environment.get(\"walletId\")); pm.expect(body.items).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Repetir criação - esperado 409",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/wallets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": {\n    \"amount\": \"1000.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. BET e idempotência",
      "item": [
        {
          "name": "Criar BET",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{betIdempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/wagering/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"{{providerId}}\",\n  \"externalTransactionId\": \"{{betExternalId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-postman-001\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"betExternalId\", \"bet-postman-\" + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.environment.set(\"betIdempotencyKey\", pm.environment.get(\"providerId\") + \":\" + pm.environment.get(\"betExternalId\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test(\"BET processada\", function () { pm.expect(body.status).to.eql(\"PROCESSED\"); pm.expect(body.balance.amount).to.eql(\"975.00\"); });",
                  "pm.environment.set(\"betTransactionId\", body.transactionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay da BET - esperado 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{betIdempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/wagering/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"{{providerId}}\",\n  \"externalTransactionId\": \"{{betExternalId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-postman-001\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"replay idempotente\", function () { pm.expect(body.idempotentReplay).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Conflito da mesma key - esperado 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{betIdempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/wagering/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"{{providerId}}\",\n  \"externalTransactionId\": \"{{betExternalId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-postman-001\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"30.00\", \"currency\": \"BRL\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
                ]
              }
            }

    {
      "name": "6. Referência fora de ordem",
      "item": [
        {
          "name": "Criar WIN pendente - esperado 202",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{pendingIdempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/wagering/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"{{providerId}}\",\n  \"externalTransactionId\": \"{{pendingExternalId}}\",\n  \"referenceExternalTransactionId\": \"{{pendingReferenceExternalId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-pending-postman\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"WIN\",\n  \"money\": { \"amount\": \"10.00\", \"currency\": \"BRL\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"pendingExternalId\", \"pending-win-postman-\" + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.environment.set(\"pendingReferenceExternalId\", \"late-bet-postman-\" + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.environment.set(\"pendingIdempotencyKey\", pm.environment.get(\"providerId\") + \":\" + pm.environment.get(\"pendingExternalId\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", function () { pm.response.to.have.status(202); });",
                  "const body = pm.response.json();",
                  "pm.test(\"WIN pendente\", function () { pm.expect(body.status).to.eql(\"PENDING_REFERENCE\"); });",
                  "pm.environment.set(\"pendingTransactionId\", body.transactionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar BET da referência tardia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{pendingReferenceIdempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/wagering/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"{{providerId}}\",\n  \"externalTransactionId\": \"{{pendingReferenceExternalId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-pending-postman\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"10.00\", \"currency\": \"BRL\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
